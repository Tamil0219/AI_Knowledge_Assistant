# AI Cartoonization Platform - Email Service Configuration
# 
# This file contains sensitive credentials. 
# ⚠️ NEVER commit this file to Git!
# ⚠️ Add .env to your .gitignore file
#
# For detailed setup instructions, see: EMAIL_SETUP_GUIDE.md

# ============================================================================
# GMAIL SMTP CONFIGURATION (Recommended for Development)
# ============================================================================
# Gmail SMTP server address
EMAIL_HOST=smtp.gmail.com

# Gmail SMTP port (use 587 for TLS)
EMAIL_PORT=587

# Your Gmail email address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
# Required steps:
#   1. Enable 2-Step Verification in your Google Account
#   2. Go to App passwords
#   3. Select "Mail" and "Windows Computer"
#   4. Copy the 16-character password and paste below
EMAIL_PASS=aaaa bbbb cccc dddd

# Email address that appears in the "From" field
# Usually same as EMAIL_USER
EMAIL_FROM=your-email@gmail.com

# Connection timeout in seconds (optional, default: 10)
EMAIL_TIMEOUT=10

# ============================================================================
# ALTERNATIVE PROVIDERS (Uncomment to use)
# ============================================================================

# Microsoft Outlook/Office 365
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-password
# EMAIL_FROM=your-email@outlook.com

# SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-username
# EMAIL_PASS=your-ses-password
# EMAIL_FROM=verified-sender@yourdomain.com

# ============================================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/email_service.log
